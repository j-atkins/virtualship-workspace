{
  "name": "VirtualShip Workspace",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "pip install git+https://github.com/Parcels-code/virtualship.git",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "remoteUser": "root"
}