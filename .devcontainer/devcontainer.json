{
  "name": "VirtualShip Workspace",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "updateContentCommand": "pixi install",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python",
        "python.terminal.activateEnvironment": true
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "pixi run python -c 'import virtualship; print(\"VirtualShip environment ready!\")'",
  "remoteUser": "root"
}